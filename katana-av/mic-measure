#!/bin/bash
# mic-measure — record N seconds from the Scarlett Mic 1 (a second reader; it never
# takes the mic from a call) and report what a call would have received:
#   frames delivered vs wall-clock expected (a stalled capture delivers fewer),
#   per-second peak / RMS in dBFS, dropouts (runs of exact digital zero >= 2 ms
#   inside a signal whose noise floor is never exactly zero), and pw-top ERR on
#   the Scarlett nodes before/after.
# The audio is kept in $XDG_RUNTIME_DIR (RAM) and deleted after analysis; only
# numbers are printed. Usage: mic-measure [seconds=60] [--source <node name>]
# Exit 0 = clean, 1 = shortfall/dropouts/new xruns, 2 = usage or no source.
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SECS=60; SRC=""
while [ $# -gt 0 ]; do
    case "$1" in
        --source) SRC="${2:-}"; shift 2 ;;
        ''|*[!0-9]*) echo "usage: mic-measure [seconds] [--source <node>]" >&2; exit 2 ;;
        *) SECS="$1"; shift ;;
    esac
done
[ -n "$SRC" ] || SRC=$(pactl list short sources 2>/dev/null | awk '$2 ~ /Scarlett.*Mic1__source$/{print $2; exit}')
[ -n "$SRC" ] || { echo "mic-measure: no Scarlett Mic1 source on $(hostname)" >&2; exit 2; }

errs() { pw-top -b -n 2 2>/dev/null | awk '/^S +ID/{blk++} blk>=2 && $2 != "ID" && $NF ~ /Scarlett/ {e += $9} END{print e+0}'; }
f=$(mktemp "$XDG_RUNTIME_DIR/mic-measure.XXXXXX.wav") || exit 2
trap 'rm -f "$f"' EXIT
e0=$(errs); t0=$(date +%s.%N)
timeout -s INT -k 3 "$SECS" pw-record --target "$SRC" --rate 48000 --channels 2 --format s16 "$f" >/dev/null 2>&1
t1=$(date +%s.%N); e1=$(errs)
echo "mic-measure  host=$(hostname)  source=$SRC  $(date '+%F %T %Z')"
python3 -I - "$f" "$t0" "$t1" "$e0" "$e1" <<'PY'
import sys, array, math
path, t0, t1, e0, e1 = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])
b = open(path, "rb").read()
i = b.find(b"data", 12)
pcm = b[i + 8:] if (b[:4] == b"RIFF" and i >= 0) else b""   # pw-record may leave the sizes at 0
pcm = pcm[: len(pcm) - len(pcm) % 4]
a = array.array("h", pcm)
if sys.byteorder != "little": a.byteswap()
rate, ch = 48000, 2
mono = a[0::ch]                                  # channel 1 = Mic 1 on the Scarlett
frames, wall = len(mono), t1 - t0
expected = int(wall * rate)
db = lambda x: "-inf" if x <= 0 else "%.1f" % (20 * math.log10(x / 32768))
def runs_of_zero(x, minlen):
    n, cur = 0, 0
    for v in x:
        if v == 0: cur += 1
        else:
            if cur >= minlen: n += 1
            cur = 0
    return n + (1 if cur >= minlen else 0)
peak = max((abs(v) for v in mono), default=0)
rms = math.sqrt(sum(v * v for v in mono) / frames) if frames else 0
all_zero = peak == 0
# A source resuming from suspend hands the first buffer(s) over zero-filled (measured on
# katana 11-08: one leading run per capture). That is start-up, not a call dropout, so
# leading/trailing zeros are reported apart and only gaps INSIDE the signal count.
lead = next((k for k, v in enumerate(mono) if v != 0), frames)
tail = next((k for k, v in enumerate(reversed(mono)) if v != 0), 0)
inner = mono[lead:frames - tail] if not all_zero else mono[:0]
drops = runs_of_zero(inner, 96)                               # 2 ms of exact zero amid a live floor
short = expected - frames
print(f"frames      {frames} delivered / ~{expected} wall-clock ({wall:.2f} s)  shortfall {max(short,0)} ({max(short,0)/rate*1000:.0f} ms)")
print(f"level       peak {db(peak)} dBFS  rms {db(rms)} dBFS" + ("  (digital silence: gain/48V/input)" if all_zero else ""))
secs = []
for s in range(frames // rate):
    w = mono[s * rate:(s + 1) * rate]
    secs.append(max(abs(v) for v in w))
if secs:
    print("per-second  peak dBFS: " + " ".join(db(p) for p in secs))
print(f"dropouts    {drops} run(s) of >= 2 ms exact zero inside the signal  (start-up silence {lead/rate*1000:.0f} ms, tail {tail/rate*1000:.0f} ms)")
print(f"xruns       pw-top ERR on Scarlett nodes {e0} -> {e1} (+{e1 - e0})")
# pw-record starts ~50-150 ms after t0; allow 250 ms of start-up before calling it a shortfall
bad = (short > rate // 4) or drops > 0 or (e1 - e0) > 0 or frames == 0
print("RESULT: " + ("FAIL" if bad else "PASS"))
sys.exit(1 if bad else 0)
PY
