def log(msg):
    print(msg, flush=True)


def load_map():
    path = MAP_FILE if MAP_FILE.exists() else DEFAULT_MAP
    m = json.loads(path.read_text())
    for key, verb in m.get("keys", {}).items():
        parse_verb(verb)   # raises on an unknown verb: the map is checked before any grab
    # Fail closed on the device: an empty or wildcard prefix would match every by-id device (JP's keyboard and mouse),
    # so the map must name the pad's full by-id name up to its interface suffix AND its USB vendor:product (lsusb).
    dev = m.get("device")
    if not isinstance(dev, str) or not re.fullmatch(r"[A-Za-z0-9_.:+-]+", dev):
        raise ValueError("device must be the pad's full by-id name up to the -event-* suffix (non-empty, no wildcards)")
    for k in ("vendor", "product"):
        v = m.get(k)
        if not isinstance(v, str) or not re.fullmatch(r"[0-9a-fA-F]{4}", v):
            raise ValueError(f"{k} must be the pad's USB {k} id as 4 hex digits (lsusb), got {v!r}")
    m["_path"] = str(path)
    return m


def parse_verb(verb):
    parts = verb.split()
    if not parts or parts[0] not in VERBS:
        raise ValueError(f"unknown verb {verb!r}")
    name, args = parts[0], parts[1:]
    allowed = VERBS[name]
    if allowed and (len(args) != 1 or args[0] not in allowed):
        raise ValueError(f"verb {name!r} takes one of {allowed}, got {args}")
    if not allowed and args:
        raise ValueError(f"verb {name!r} takes no argument")
    return name, (args[0] if args else None)


class BackedOff(Exception):
    pass


class WrongDevice(Exception):
    """A device under the pad's by-id name is not the pad (vendor:product differ): never grabbed, exit 2."""


class PadDead(Exception):
    """The worker thread died: nothing would run the next press, so the daemon exits 1 (systemd restarts it)."""


class Stop:
    """Set from a signal handler. A plain flag plus a self-pipe, never a threading.Event: its set() takes a
    non-reentrant lock that the interrupted main thread may hold (deadlock, xreview on PR 32). The pipe's read end
    sits in the pad's selector, so SIGTERM wakes the read loop at once instead of at its next timeout."""
    def __init__(self):
        self.flag = False
        self.r, self.w = os.pipe()
        os.set_blocking(self.w, False)

    def set(self, *_):
        self.flag = True
        try:
            os.write(self.w, b"s")
        except OSError:
            pass

    def is_set(self):
        return self.flag

    def wait(self, timeout):
        select.select([self.r], [], [], timeout)


class Lock:
    """`flock -n` on the camera-stack lock: the same kernel lock ha takes with `flock -x` during its restart window."""
    def __enter__(self):
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(self.fd)
            raise BackedOff("lock held")
        return self

    def __exit__(self, *_):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


class Actions:
    def __init__(self, dry_run=False):
        self.dry_run = dry_run
        self._cl = None

    # -- helpers ------------------------------------------------------------------------------------------------
    def obs(self):
        if self._cl is None:
            import obsws_python as obs
            cfg = json.loads((HOME / ".config/obs-studio/plugin_config/obs-websocket/config.json").read_text())
            self._cl = obs.ReqClient(host="127.0.0.1", port=cfg.get("server_port", 4455),
                                     password=cfg.get("server_password", ""), timeout=5)
        return self._cl

    def sh(self, *argv, timeout=120):
        if self.dry_run:
            return 0, f"would run: {' '.join(argv)}"
        if argv[0] == "camera-mode" and ESCAPE == "systemd-run":
            # The serve unit is sandboxed (ProtectSystem=strict, NoNewPrivileges …); camera-mode's wedge recovery
            # is reset-camera.sh = `sudo tee` into sysfs, impossible in there. It runs as its own transient user
            # unit instead (the user bus is reachable from the sandbox), output piped back, exit code propagated,
            # and it dies on its own a little before our timeout would abandon it. Accepted limit (xreview on
            # PR 33): this is delegation, not a boundary. A compromised daemon can ask the user manager for any
            # unsandboxed unit; the sandbox contains the HTTP path and the OBS/PipeWire work, not a takeover of
            # the process itself. The HTTP path exposes only parse_verb's allow-list, never a command.
            argv = ("systemd-run", "--user", "--quiet", "--wait", "--pipe", "--collect",
                    f"--property=RuntimeMaxSec={max(int(timeout) - 10, 10)}", "--") + argv
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()

    def state(self):
        try:
            return json.loads(STATE.read_text())
        except (OSError, ValueError):
            return {}

    def save_state(self, **kw):
        s = dict(self.state(), **kw)
        STATE.parent.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(s))
        os.replace(tmp, STATE)

    # -- verbs --------------------------------------------------------------------------------------------------
    def scene(self, which):
        with Lock():
            rc, out = self.sh("camera-scene", which)
        return rc, out

    def mic(self, how):
        if how in ("toggle", "mute", "unmute"):
            arg = {"toggle": "toggle", "mute": "1", "unmute": "0"}[how]
            rc, out = self.sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", arg)
            if rc:
                return rc, out
        return 0, "mic " + ("muted" if self.mic_muted() else "live")

    def mic_muted(self):
        if self.dry_run:
            return None
        rc, out = self.sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
        return "MUTED" in out

    def camera(self, how):
        if self.dry_run:
            return 0, f"would {how} {CAMERA_SOURCES} in the program scene"
        cl = self.obs()
        with Lock():
            scene = cl.get_current_program_scene().current_program_scene_name
            items = [i for i in cl.get_scene_item_list(scene).scene_items if i["sourceName"] in CAMERA_SOURCES]
            if not items:
                return 1, f"no camera source in '{scene}'"
            shown = any(i["sceneItemEnabled"] for i in items)
            want = {"toggle": not shown, "hide": False, "show": True}[how]
            for i in items:
                cl.set_scene_item_enabled(scene, i["sceneItemId"], want)
        return 0, f"camera {'shown' if want else 'hidden'} in '{scene}'"

    def record(self, _):
        if self.dry_run:
            return 0, "would ToggleRecord"
        with Lock():
            active = self.obs().toggle_record().output_active
        return 0, "recording" if active else "record stopped"

    def stream(self, _):
        if self.dry_run:
            return 0, "would ToggleStream (if a stream service exists)"
        cl = self.obs()
        s = cl.get_stream_service_settings().stream_service_settings or {}
        if not s.get("server") or not s.get("key"):
            return 1, "no stream service configured; stream key does nothing"
        with Lock():
            active = cl.toggle_stream().output_active
        return 0, "streaming" if active else "stream stopped"

    def camera_mode(self, which):
        if which == "toggle":
            last = self.state().get("camera_mode")
            if last not in ("hdr", "fast"):
                rc, out = self.sh("camera-mode", "status")
                last = "fast" if "camera-mode fast" in out else "hdr"
            which = "hdr" if last == "fast" else "fast"
        with Lock():
            rc, out = self.sh("camera-mode", which, timeout=180)
        if rc == 0 and not self.dry_run:
            self.save_state(camera_mode=which)
        return rc, out

    def safe(self, _):
        outs, worst = [], 0
        for fn, arg in ((self.scene, "plain"), (self.camera, "show"), (self.mic, "unmute")):
            try:
                rc, out = fn(arg)
            except BackedOff:
                rc, out = 4, f"{fn.__name__}: backed off (lock held)"
            worst = max(worst, rc)
            outs.append(out)
        return worst, " · ".join(outs)

    def status_dict(self):
        """Reads only. Raises on an OBS failure."""
        if self.dry_run:
            return {"dry_run": True, "scene": "?", "mic": "?", "camera": "?", "record": "?", "vcam": "?",
                    "camera_mode": self.state().get("camera_mode", "?")}
        cl = self.obs()
        scene = cl.get_current_program_scene().current_program_scene_name
        items = [i for i in cl.get_scene_item_list(scene).scene_items if i["sourceName"] in CAMERA_SOURCES]
        return {"scene": scene,
                "camera": "shown" if any(i["sceneItemEnabled"] for i in items) else ("hidden" if items else "none"),
                "record": "on" if cl.get_record_status().output_active else "off",
                "vcam": "on" if cl.get_virtual_cam_status().output_active else "off",
                "mic": "muted" if self.mic_muted() else "live",
                "camera_mode": self.state().get("camera_mode", "?")}

    def status(self, _):
        try:
            d = self.status_dict()
        except Exception as e:   # noqa: BLE001 — the status line names the failure instead of a traceback
            return 3, f"OBS not answering ({type(e).__name__})"
        if d.get("dry_run"):
            return 0, "would read status"
        return 0, (f"scene '{d['scene']}' · mic {d['mic']} · camera {d['camera']} · record {d['record']} · "
                   f"vcam {d['vcam']} · camera-mode {d['camera_mode']}")

    def none(self, _):
        return 0, "unmapped"

    def do(self, verb):
        name, arg = parse_verb(verb)
        fn = getattr(self, name.replace("-", "_"))
        t0 = time.monotonic()
        try:
            rc, out = fn(arg)
        except BackedOff:
            rc, out = 4, "backed off (lock held)"
        except Exception as e:   # noqa: BLE001 — one line per press, never a traceback in the journal
            rc, out = 3, f"{type(e).__name__}: {e}"
        return rc, out, int((time.monotonic() - t0) * 1000)


# -- the pad ----------------------------------------------------------------------------------------------------
def find_devices(prefix):
    """The event interfaces of the ONE pad: <by-id>/<prefix>[-ifNN]-event-<kind>. The prefix is the pad's full by-id
    name up to its interface suffix, matched whole, so a short or empty prefix can never widen to JP's keyboard and
    mouse (an empty prefix raises; the map check already refused it)."""
    if not prefix:
        raise ValueError("empty device prefix")
    pat = re.compile(re.escape(prefix) + r"(-if\d+)?-event-[a-z0-9]+")
    return sorted(str(p) for p in BY_ID.glob(glob.escape(prefix) + "*") if pat.fullmatch(p.name))


class Pad:
    def __init__(self, paths, keymap, actions):
        import evdev
        self.evdev, self.paths, self.actions = evdev, paths, actions
        self.keymap = keymap["keys"]
        self.ids = (int(keymap["vendor"], 16), int(keymap["product"], 16))
        self.devs, self.sel = [], selectors.DefaultSelector()
        self.q = queue.Queue()
        self.busy = threading.Lock()   # held from the press that is accepted until its action has finished
        self.worker = threading.Thread(target=self._work, name="pad-worker", daemon=True)
        self.worker.start()

    def grab(self):
        for p in self.paths:
            d = self.evdev.InputDevice(p)
            got = (d.info.vendor, d.info.product)
            if got != self.ids:   # fail closed: a stranger under the pad's name is never grabbed
                d.close()
                raise WrongDevice(f"refusing {os.path.realpath(p)} ({d.name}): usb id {got[0]:04x}:{got[1]:04x} "
                                  f"is not the pad's {self.ids[0]:04x}:{self.ids[1]:04x}")
            d.grab()
            self.devs.append(d)
            self.sel.register(d.fd, selectors.EVENT_READ, d)
            log(f"grabbed {os.path.realpath(p)} ({d.name} {got[0]:04x}:{got[1]:04x})")
        self._led()

    def release(self):
        # Stop and join the worker FIRST: an in-flight verb finishes (camera-mode: ~20 s) while the pad is still ours,
        # so its keys never reach a window during a stop; nothing queued can run after this returns, and a re-plugged
        # pad gets a fresh worker (the old one is gone: no thread per unplug).
        if self.worker.is_alive():
            if self.busy.locked():
                log("finishing the running verb before release")
            self.q.put(None)
            self.worker.join()
        for d in self.devs:
            try:
                self.sel.unregister(d.fd)
                d.ungrab()
                d.close()
            except OSError:
                pass
        self.devs = []

    def _led(self):
        muted = self.actions.mic_muted()
        for d in self.devs:
            try:
                d.set_led(self.evdev.ecodes.LED_NUML, 1 if muted else 0)   # NumLock LED on = mic muted
            except OSError:
                pass

    def _work(self):
        while True:
            item = self.q.get()
            if item is None:
                return
            key, verb = item
            try:
                rc, out, ms = self.actions.do(verb)   # never raises on a verb failure (rc 3 + one line)
                log(f"key={key} verb={verb!r} rc={rc} {ms}ms {out}")
                if verb.split()[0] in ("mic", "safe"):
                    self._led()
            except Exception as e:   # noqa: BLE001 — the worker survives anything a press can throw at it
                log(f"key={key} verb={verb!r} worker error {type(e).__name__}: {e}")
            finally:
                self.busy.release()

    def press(self, key):
        """One action at a time and NOTHING queued: a press while a verb runs is dropped, not run later (the busy
        flag is taken here and released by the worker only when the action has finished)."""
        verb = self.keymap.get(key)
        if not verb or verb == "none":
            log(f"key={key} unmapped")
            return
        if not self.worker.is_alive():   # nobody would run it: a latched busy flag forever is worse than a restart
            raise PadDead("worker thread died")
        if not self.busy.acquire(blocking=False):
            log(f"key={key} verb={verb!r} dropped (busy)")
            return
        self.q.put((key, verb))

    def loop(self, stop):
        """Read until a device goes away (unplug) or stop is set (SIGTERM); the caller re-waits or exits."""
        self.sel.register(stop.r, selectors.EVENT_READ, None)
        try:
            self._loop(stop)
        finally:
            self.sel.unregister(stop.r)

    def _loop(self, stop):
        while not stop.is_set():
            for sk, _ in self.sel.select(timeout=1.0):
                d = sk.data
                if d is None:   # the stop pipe
                    return
                try:
                    events = list(d.read())
                except OSError:
                    return
                for e in events:
                    if stop.is_set():   # a press read in the same batch as SIGTERM is not accepted: nothing new starts
                        return
                    if e.type == self.evdev.ecodes.EV_KEY and e.value == 1:   # key down only: no repeat, no release
                        name = self.evdev.ecodes.KEY.get(e.code, str(e.code))
                        if isinstance(name, list):
                            name = name[0]
                        self.press(name)


def run(args, keymap, actions):
    """Exit 0 on SIGTERM/SIGINT after the running verb (if any) has finished and the pad is released; exit 2 when a
    device under the pad's name is not the pad (the unit does not restart on 2: it is a config error); exit 1 when
    the worker thread died (the unit restarts)."""
    prefix = keymap["device"]
    stop = Stop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, stop.set)
    waited = False
    while not stop.is_set():
        paths = list(args.device) if args.device else find_devices(prefix)
        if not paths:
            if not waited:
                log(f"pad not plugged in (by-id {prefix}[-ifNN]-event-*); waiting")
                waited = True
            stop.wait(2)
            continue
        waited = False
        pad = Pad(paths, keymap, actions)
        try:
            pad.grab()
            pad.loop(stop)
        except WrongDevice as e:
            log(str(e))
            return 2
        except PadDead as e:
            log(f"{e}; exiting for a restart")
            return 1
        except OSError as e:
            log(f"pad error ({type(e).__name__}: {e}); waiting for it")
        finally:
            pad.release()
        if stop.is_set():
            break
        log("pad gone; waiting")
        stop.wait(2)
    log("stopped (pad released)")
    return 0


# -- the HTTP side --------------------------------------------------------------------------------------------------
RC_HTTP = {0: 200, 1: 500, 2: 400, 3: 502, 4: 423}   # 423 Locked = backed off (ha holds the camera-stack lock)


def load_token():
    """The shared secret every HTTP caller presents (Companion's connection auth, HA's rest_command, curl): a 0600
    file owned by us, 32+ characters; install.sh makes one. Anything else = refuse to serve (exit 2)."""
    try:
        st = TOKEN_FILE.stat()
    except OSError as e:
        raise ValueError(f"no token file {TOKEN_FILE} ({e.strerror}): install.sh makes one") from None
    if st.st_mode & 0o077:
        raise ValueError(f"{TOKEN_FILE} must be 0600, is {st.st_mode & 0o777:04o}")
    if st.st_uid != os.getuid():
        raise ValueError(f"{TOKEN_FILE} is not ours (uid {st.st_uid})")
    tok = TOKEN_FILE.read_text().strip()
    if len(tok) < 32 or not tok.isprintable() or any(c.isspace() for c in tok):
        raise ValueError(f"{TOKEN_FILE}: token must be 32+ printable characters, no spaces")
    return tok


def is_loopback(host):
    """A loopback IP literal: 127.0.0.0/8 or ::1 (also '[::1]'). Never a name, never 0.0.0.0, never a LAN address."""
    try:
        return ipaddress.ip_address(host.strip("[]")).is_loopback
    except ValueError:
        return False


HOST_RE = re.compile(r"(\[[0-9A-Fa-f:.]+\]|[0-9.]+|localhost)(?::[0-9]{1,5})?")


def host_header_ok(value):
    """Host: must be a well-formed loopback authority (DNS rebinding / a LAN name pointing here): '[::1]:8765',
    '127.0.0.1:8765', 'localhost'. Anything malformed ('[::1]evil', '127.0.0.1:x') is refused, not parsed around."""
    m = HOST_RE.fullmatch((value or "").strip())
    return bool(m) and (m.group(1) == "localhost" or is_loopback(m.group(1)))


class CompanionPush:
    """Companion's own OBS module shows scene, record, vcam and source state; what it cannot see (the PipeWire mic,
    camera-mode) goes into its custom variables pad_mic, pad_mode, pad_camera over its HTTP API
    (POST /api/custom-variable/<name>/value?value=…). Pushed after every verb and every PUSH_EVERY seconds; only
    changes are sent; a Companion that is down is logged once, never retried in a loop."""
    def __init__(self, actions, url=COMPANION_URL):
        self.actions, self.url, self.last, self.down, self.n = actions, url.rstrip("/"), {}, False, 0

    def push(self):
        if not self.url:
            return
        try:
            d = self.actions.status_dict()
        except Exception:   # noqa: BLE001 — OBS away: nothing to push
            return
        vals = {"pad_mic": d.get("mic", "?"), "pad_mode": d.get("camera_mode", "?"), "pad_camera": d.get("camera", "?")}
        for name, value in vals.items():
            if self.last.get(name) == value and self.n % RESYNC_EVERY:
                continue   # changes go at once; every RESYNC_EVERY cycles the value is re-read, since a Companion
            try:           # restart empties its custom variables (measured 2026-11-17 15:2x) and 'unchanged' lies
                if self.last.get(name) == value:
                    cur = urllib.request.urlopen(f"{self.url}/api/custom-variable/{name}/value", timeout=2).read().decode()
                    if cur == str(value):
                        continue
                req = urllib.request.Request(f"{self.url}/api/custom-variable/{name}/value?value="
                                             + urllib.parse.quote(str(value)), method="POST")
                urllib.request.urlopen(req, timeout=2).read()
                self.last[name] = value
                if self.down:
                    log("companion back")
                    self.down = False
            except Exception as e:   # noqa: BLE001
                if not self.down:
                    log(f"companion push failed ({type(e).__name__}); will retry quietly")
                    self.down = True
                return

    def run_forever(self):
        while True:
            self.n += 1
            self.push()
            time.sleep(PUSH_EVERY)


def serve(bind, actions):
    """Loopback only (refuses any other bind address). Every request: no browser Origin, a loopback Host, and the
    token (Bearer, or Basic with the token as password: Companion's connection auth). POST carries no body. One
    action at a time (a second POST while one runs gets 409), the same verbs and the same lock as the pad, so
    Companion, HA and the CYD deck never write OBS behind camera-scene's or ha's back. HTTP_WORKERS connections at
    once (more get 503 at once), HTTP_TIMEOUT seconds for a stalled client."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    host, _, port = bind.rpartition(":")
    host = host or "127.0.0.1"
    if not is_loopback(host):
        log(f"refusing to bind {bind}: loopback only (127.0.0.1 or [::1])")
        return 2
    try:
        token = load_token()
    except ValueError as e:
        log(f"refusing to serve: {e}")
        return 2
    busy = threading.Lock()
    pusher = CompanionPush(actions)
    threading.Thread(target=pusher.run_forever, daemon=True).start()

    class H(BaseHTTPRequestHandler):
        timeout = HTTP_TIMEOUT   # per-receive socket timeout (an idle client)…

        def setup(self):
            super().setup()
            # …and an absolute deadline for the request head: the buffered reader loops over receives inside one
            # readline, so only something outside the read path can end a client that trickles bytes without ever
            # finishing a line. The watchdog shuts the socket at HTTP_TIMEOUT; parse_request cancels it.
            self.gate = threading.Lock()   # admitted xor expired: the parser and the watchdog race for it
            self.admitted = self.expired = False
            self.watchdog = threading.Timer(HTTP_TIMEOUT, self._deadline)
            self.watchdog.daemon = True
            self.watchdog.start()

        def _deadline(self):
            with self.gate:
                if self.admitted:
                    return
                self.expired = True
            try:
                self.connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

        def _admit(self):
            """Called once the head AND the body are in. The header parser takes EOF as the end of the headers, so
            the watchdog's shutdown could complete an unterminated head (or a short body): an expired request is
            never admitted, whatever the parser made of it; an admitted one is never shut down mid-verb."""
            with self.gate:
                if self.expired:
                    self.close_connection = True
                    return False
                self.admitted = True
            self.watchdog.cancel()
            return True

        def finish(self):
            self.watchdog.cancel()
            super().finish()

        def log_message(self, *_):
            pass

        def _one(self, name):
            """Exactly one header of that name, else None (a duplicate Host or Authorization is never guessed at)."""
            vals = self.headers.get_all(name) or []
            return vals[0] if len(vals) == 1 else None

        def _json(self, code, obj):
            body = json.dumps(obj).encode()
            try:
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            except OSError:   # the client (or the watchdog) closed the socket under us: nothing to answer
                pass

        def _admitted(self):
            """Origin → 403 (a page in a browser, cross-site or not, never drives the stack); Host not loopback →
            403; token missing or wrong → 401 (no WWW-Authenticate: a browser must not pop a login box)."""
            if "Origin" in self.headers:
                self._json(403, {"error": "browser origin refused"})
                return False
            if not host_header_ok(self._one("Host")):
                self._json(403, {"error": "host must be loopback"})
                return False
            scheme, _, cred = (self._one("Authorization") or "").strip().partition(" ")
            scheme, cred, given = scheme.lower(), cred.strip(), ""
            if scheme == "bearer":
                given = cred
            elif scheme == "basic":
                try:
                    given = base64.b64decode(cred, validate=True).decode().split(":", 1)[1]
                except (ValueError, IndexError, UnicodeDecodeError):
                    given = ""
            if not hmac.compare_digest(given.encode(), token.encode()):
                self._json(401, {"error": "token required (Authorization: Bearer <token>)"})
                return False
            return True

        def _body_read(self):
            """Arguments live in the path; a body is never used. Companion's generic-http always sends one ('{}'),
            so a body is tolerated: exactly one decimal Content-Length of at most BODY_MAX bytes (else 400/413),
            never a Transfer-Encoding, and the bytes are read and dropped before admission, so a body that stalls
            or trickles still meets the deadline."""
            cl = self.headers.get_all("Content-Length") or []
            if self.headers.get_all("Transfer-Encoding") or len(cl) > 1 or (cl and not cl[0].strip().isdigit()):
                self._json(400, {"error": "bad body framing: one decimal Content-Length or none, no Transfer-Encoding"})
                return False
            n = int(cl[0]) if cl else 0
            if n > BODY_MAX:
                self._json(413, {"error": f"body too large (ignored anyway): {BODY_MAX} bytes at most"})
                return False
            if n:
                try:
                    data = self.rfile.read(n)
                except (OSError, ValueError):
                    data = b""
                if len(data) != n:   # the client went away, or the deadline shut the socket
                    self.close_connection = True
                    return False
            return True

        def do_GET(self):
            if not self._admit() or not self._admitted():
                return
            if self.path.split("?")[0] in ("/status", "/status/"):
                try:
                    return self._json(200, actions.status_dict())
                except Exception as e:   # noqa: BLE001
                    return self._json(502, {"error": f"OBS not answering ({type(e).__name__})"})
            self._json(404, {"error": "GET /status or POST /do/<verb>[/<arg>]"})

        def do_POST(self):
            if not self._body_read() or not self._admit() or not self._admitted():
                return
            m = re.fullmatch(r"/do/([a-z-]+)(?:/([a-z]+))?/?", self.path.split("?")[0])
            if not m:
                return self._json(404, {"error": "POST /do/<verb>[/<arg>]"})
            verb = m.group(1) + (f" {m.group(2)}" if m.group(2) else "")
            try:
                parse_verb(verb)
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            if not busy.acquire(blocking=False):
                return self._json(409, {"error": "busy", "verb": verb})
            try:
                rc, out, ms = actions.do(verb)
            finally:
                busy.release()
            log(f"http verb={verb!r} rc={rc} {ms}ms {out}")
            self._json(RC_HTTP.get(rc, 500), {"verb": verb, "rc": rc, "out": out, "ms": ms})
            pusher.push()

    class Srv(ThreadingHTTPServer):
        daemon_threads = True
        request_queue_size = 16
        address_family = socket.AF_INET6 if ":" in host else socket.AF_INET

        def __init__(self, *a):
            super().__init__(*a)
            self.slots = threading.BoundedSemaphore(HTTP_WORKERS)

        def process_request(self, request, client_address):
            if not self.slots.acquire(blocking=False):   # bounded workers: the extra connection is answered and closed
                try:
                    request.sendall(b"HTTP/1.0 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                except OSError:
                    pass
                self.shutdown_request(request)
                return
            try:
                super().process_request(request, client_address)
            except BaseException:   # the thread never started: give the permit back, then the usual error path
                self.slots.release()
                raise

        def process_request_thread(self, request, client_address):
            try:
                super().process_request_thread(request, client_address)
            finally:
                self.slots.release()

    srv = Srv((host.strip("[]"), int(port)), H)
    log(f"serving on http://{host}:{port} (loopback, token from {TOKEN_FILE}, {HTTP_WORKERS} workers, {HTTP_TIMEOUT:g}s timeout)")
    srv.serve_forever()
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="obs-macro-pad", add_help=False)
    ap.add_argument("cmd", nargs="?", default="")
    ap.add_argument("rest", nargs="*")
    ap.add_argument("--device", action="append", default=[])
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--bind", default=os.environ.get("OBS_MACRO_PAD_BIND", "127.0.0.1:8765"))
    a = ap.parse_args(argv[1:])
    if a.cmd not in ("run", "do", "status", "map", "find", "serve"):
        print(__doc__.split("\n\n")[0], file=sys.stderr)
        print("usage: obs-macro-pad run|do <verb> [arg]|status|map|find|serve", file=sys.stderr)
        return 2
    try:
        keymap = load_map()
    except (OSError, ValueError) as e:
        print(f"obs-macro-pad: bad map: {e}", file=sys.stderr)
        return 2
    actions = Actions(dry_run=a.dry_run)
    if a.cmd == "map":
        print(f"map {keymap['_path']} · device by-id {keymap['device']}[-ifNN]-event-* · usb {keymap['vendor']}:{keymap['product']}")
        for k, v in keymap["keys"].items():
            print(f"  {k:16s} {v}")
        return 0
    if a.cmd == "find":   # what `run` would grab; nothing is touched
        paths = find_devices(keymap["device"])
        for p in paths:
            print(f"{p} -> {os.path.realpath(p)}")
        return 0 if paths else 1
    if a.cmd == "status":
        rc, out, _ = actions.do("status")
        print(f"obs-macro-pad: {out}")
        return rc
    if a.cmd == "do":
        if not a.rest:
            print("usage: obs-macro-pad do <verb> [arg]", file=sys.stderr)
            return 2
        try:
            parse_verb(" ".join(a.rest))
        except ValueError as e:
            print(f"obs-macro-pad: {e}", file=sys.stderr)
            return 2
        rc, out, ms = actions.do(" ".join(a.rest))
        print(f"obs-macro-pad: {out} ({ms}ms)")
        return rc
    if a.cmd == "serve":
        return serve(a.bind, actions)
    return run(a, keymap, actions)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
