+def open_room(args, w: int, h: int, black: bytes) -> Device | None:
+    """--room-output is optional: ANY failure setting it up is logged and the daemon runs without it."""
+    room = None
+    try:
+        room = Device(args.room_output)
+        room.open()
+        os.set_blocking(room.fileno(), False)  # bounded: the first black write below must never wait on a reader
