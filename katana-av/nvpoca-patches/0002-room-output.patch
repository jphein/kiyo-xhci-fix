+def write_room(args, raw, src, room_buf: torch.Tensor | None) -> None:
+    """--room-output: the camera frame before any effect. yuyv input is already the loopback format (bytes as
+    captured); mjpg input is converted from the decoded frame. OPTIONAL output: it must never stop the stream (that
+    closes the camera, and the Kiyo wedges on reopen). The fd is non-blocking: a full loopback drops this room frame;
+    any other error logs once and turns the room output off for the life of this worker."""
+    if args.room_fd is None:
+        return
+    try:
+        if args.input_format == "yuyv":
+            data = raw
+        else:
+            room_buf.copy_(gpu.to_yuyv(src))
+            data = room_buf.numpy()
+        n = os.write(args.room_fd, data)
+        if n != len(memoryview(data).cast("B")):
+            raise OSError(f"short write ({n} bytes) to the room loopback device")
+    except BlockingIOError:
+        pass  # no room in the loopback right now: drop this room frame, never wait
+    except (OSError, RuntimeError) as e:
+        log(f"room output disabled: {e}")
+        args.room_fd = None
+
+
+def room_black(args, black) -> None:
+    if args.room_fd is None:
+        return
+    try:
+        os.write(args.room_fd, black)
+    except OSError:
+        pass  # best effort, like every room write
+
