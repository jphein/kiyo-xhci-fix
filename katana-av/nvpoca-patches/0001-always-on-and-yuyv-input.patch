 MODELS = Path(__file__).resolve().parent.parent / "models"
 
 
+def from_yuyv(data: torch.Tensor, h: int, w: int) -> torch.Tensor:
+    """Raw YUYV bytes (CPU uint8, BT.601 limited range) -> (1, 3, H, W) half on GPU; the inverse of gpu.to_yuyv."""
+    if data.numel() != h * w * 2:
+        raise RuntimeError(f"yuyv frame is {data.numel()} bytes, expected {h * w * 2}")
+    px = data.to(DEVICE, non_blocking=True).view(h, w // 2, 4).float()
+    y0, u, y1, v = px.unbind(-1)
+    y = torch.stack((y0, y1), dim=-1).flatten(-2)  # (h, w)
+    u = (u - 128).repeat_interleave(2, dim=-1) / 112
+    v = (v - 128).repeat_interleave(2, dim=-1) / 112
+    y = (y - 16) / 219
+    r = y + 0.701 * v
+    b = y + 0.886 * u
+    g = (y - 0.299 * r - 0.114 * b) / 0.587
+    return torch.stack((r, g, b))[None].clamp_(0, 1).half()
+
+
+DEVICE = "cuda"
+
+
