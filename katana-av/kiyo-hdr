#!/usr/bin/env python3
"""kiyo-hdr — switch the Razer Kiyo Pro's HDR off/on from Linux (one UVC extension-unit SET_CUR).

Why: at 1080p the Kiyo Pro delivers ~30 distinct fps with HDR on (Razer: "HDR at 30 fps"); measured
on both units 2026-11-08/09. Protocol from soyersoyer/kiyoproctrls (now cameractrls): extension unit
GUID 23e49ed0-1178-4f31-ae52-d2fb8a8d3b48, selector 0x01 (EU1_SET_ISP), UVC_GET_LEN then UVC_SET_CUR
with an 8-byte payload padded to that length. Research + risk: scratch/research/kiyo-hdr-xu-2026-11-09.md.

Safety: the unit id is read from the device's own descriptors (never assumed); the selector is fixed
at 1 and checked, because selector 3 on the same unit is the firmware-flash protocol. `off`/`on` are
volatile (lost at the next power-up); `save` writes the camera's flash and is refused unless the
previous command in this run was off/on and --save-flash is given. Nothing runs without --yes.

Usage: kiyo-hdr off|on [--save-flash] --yes [--dev /dev/videoN]
"""
from __future__ import annotations

import argparse, ctypes, fcntl, glob, os, sys

GUID = bytes.fromhex("d09ee423781131" "4f" "ae52d2fb8a8d3b48")   # 23e49ed0-1178-4f31-ae52-d2fb8a8d3b48, little-endian fields
SELECTOR = 0x01                                                    # EU1_SET_ISP — never 3 (firmware flash)
UVC_SET_CUR, UVC_GET_LEN = 0x01, 0x85
PAYLOAD = {"off": b"\xff\x02\x00\x00\x00\x00\x00\x00", "on": b"\xff\x02\x01\x00\x00\x00\x00\x00"}
SAVE = b"\xc0\x03\xa8\x00\x00\x00\x00\x00"


class XuQuery(ctypes.Structure):
    _fields_ = [("unit", ctypes.c_uint8), ("selector", ctypes.c_uint8), ("query", ctypes.c_uint8),
                ("size", ctypes.c_uint16), ("data", ctypes.c_void_p)]


def _iowr(t, nr, size):
    return (3 << 30) | (size << 16) | (ord(t) << 8) | nr


UVCIOC_CTRL_QUERY = _iowr("u", 0x21, ctypes.sizeof(XuQuery))


def kiyo_port(sysfs="/sys") -> str:
    for d in glob.glob(f"{sysfs}/bus/usb/devices/*"):
        try:
            if open(f"{d}/idVendor").read().strip() == "1532" and open(f"{d}/idProduct").read().strip() == "0e05":
                return d
        except OSError:
            continue
    sys.exit("kiyo-hdr: no Kiyo Pro (1532:0e05) on this host")


def unit_id(port: str) -> int:
    d = open(f"{port}/descriptors", "rb").read()
    i = d.find(GUID)
    if i < 1 or d[i - 3] != 0x24 or d[i - 2] != 0x06:   # CS_INTERFACE, VC_EXTENSION_UNIT, then bUnitID, then GUID
        sys.exit("kiyo-hdr: Razer EU1 extension unit not found in the descriptors; refusing to guess a unit id")
    return d[i - 1]


def query(fd, unit, query_code, buf):
    assert SELECTOR == 0x01, "selector must stay 1 (3 is firmware flash)"
    q = XuQuery(unit, SELECTOR, query_code, len(buf), ctypes.cast(buf, ctypes.c_void_p))
    fcntl.ioctl(fd, UVCIOC_CTRL_QUERY, q)


def send(fd, unit, payload: bytes):
    lb = ctypes.create_string_buffer(2)
    query(fd, unit, UVC_GET_LEN, lb)
    n = int.from_bytes(lb.raw, "little")
    if not 8 <= n <= 64:
        sys.exit(f"kiyo-hdr: unexpected control length {n}; refusing")
    query(fd, unit, UVC_SET_CUR, ctypes.create_string_buffer(payload.ljust(n, b"\0"), n))
    return n


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("state", choices=["off", "on"])
    ap.add_argument("--save-flash", action="store_true", help="also write the setting to the camera's flash")
    ap.add_argument("--yes", action="store_true", help="required: this sends a control transfer to the camera")
    ap.add_argument("--dev")
    a = ap.parse_args(argv)
    port = kiyo_port()
    unit = unit_id(port)
    dev = a.dev or sorted(glob.glob(f"{port}/{os.path.basename(port)}:1.0/video4linux/video*"))[0].replace(
        f"{port}/{os.path.basename(port)}:1.0/video4linux/", "/dev/")
    print(f"kiyo-hdr: camera {os.path.basename(port)} dev {dev} unit {unit} selector {SELECTOR} → HDR {a.state}"
          + (" + SAVE to flash" if a.save_flash else " (volatile)"))
    if not a.yes:
        print("dry run: add --yes to send"); return 0
    fd = os.open(dev, os.O_RDWR)
    try:
        n = send(fd, unit, PAYLOAD[a.state])
        print(f"sent HDR {a.state} ({n}-byte control)")
        if a.save_flash:
            send(fd, unit, SAVE); print("sent SAVE (camera flash)")
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
