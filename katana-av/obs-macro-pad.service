[Unit]
Description=OBS macro pad: grab the 10-key USB pad and run call-stack verbs (katana-av/obs-macro-pad)
Documentation=file:///home/jp/Projects/kiyo-xhci-fix/docs/superpowers/specs/2026-11-17-obs-macro-pad.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Enabled on JP's GO (card 85e5688df08d, 2026-11-17 17:45); install.sh copies the unit but never restarts it (a grab).
ExecStart=%h/Projects/kiyo-xhci-fix/katana-av/obs-macro-pad run
Restart=on-failure
# exit 2 = a device under the pad's by-id name is not the pad (config error): stay stopped instead of looping
RestartPreventExitStatus=2
RestartSec=3
# Stop: SIGTERM to the daemon only (not to a camera-mode/camera-scene child); the daemon finishes the verb in flight
# (camera-mode ~20 s, the camera-stack lock held until it ends, the pad still grabbed), releases the pad and exits 0.
# Whatever is left in the cgroup when the daemon exits or the timeout runs out is SIGKILLed with it: no child
# outlives the unit (xreview on PR 26). Not covered: a daemon crash or an over-budget verb ends the flock before
# the child is killed (seconds, within the same stop); an absolute lock lifetime would need the child to hold it.
KillMode=mixed
TimeoutStopSec=45

[Install]
WantedBy=graphical-session.target
