@@ -36,6 +36,34 @@
 	u8 type = USB_TYPE_CLASS | USB_RECIP_INTERFACE;
 	unsigned int pipe;
 
+	/*
+	 * Rate-limit control transfers for devices with fragile firmware
+	 * (UVC_QUIRK_CTRL_THROTTLE, Razer Kiyo Pro). Sustained rapid
+	 * control transfers can wedge the device's stream-reconfiguration
+	 * path; the hung COMMIT then cascades into xHCI controller death
+	 * on Intel Cannon Lake. Spacing reconfiguration churn reduces how
+	 * often the two-phase lock is entered. COMMIT_CONTROL gets extra
+	 * headroom (200ms vs 100ms). The former 10s URB-timeout extension
+	 * is deliberately NOT carried forward: wire captures (2026-06-13)
+	 * and a zero-warning cascade (2026-06-30) showed it only stretches
+	 * the wedge-to-death window without preventing the fault.
+	 */
+	if (dev->quirks & UVC_QUIRK_CTRL_THROTTLE) {
+		bool is_commit = (query == UVC_SET_CUR &&
+				  cs == UVC_VS_COMMIT_CONTROL);
+		unsigned long min_interval =
+			msecs_to_jiffies(is_commit ? 200 : 100);
+
+		if (dev->last_ctrl_jiffies &&
+		    time_before(jiffies,
+				dev->last_ctrl_jiffies + min_interval)) {
+			unsigned long wait = dev->last_ctrl_jiffies +
+					     min_interval - jiffies;
+			msleep(jiffies_to_msecs(wait));
+		}
+		dev->last_ctrl_jiffies = jiffies;
+	}
+
 	pipe = (query & 0x80) ? usb_rcvctrlpipe(dev->udev, 0)
 			      : usb_sndctrlpipe(dev->udev, 0);
 	type |= (query & 0x80) ? USB_DIR_IN : USB_DIR_OUT;
